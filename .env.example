# Copy this file to .env and edit the values. Use forward slashes on every OS.
# Paths may be absolute or relative to this folder.

# Required: folder that holds one sub-folder per subject, e.g.
#   <BIOVID_PARTB_DIR>/071309_w_21/071309_w_21-BL1-081_bio.csv
# In the official download this is  .../PartB/biosignals_filtered/biosignals_filtered
BIOVID_PARTB_DIR=/path/to/BioVid/PartB/biosignals_filtered/biosignals_filtered

# Optional: where features, models, reports and figures are written (default: ./outputs)
BIOVID_OUTPUT_DIR=./outputs

# Optional: parallel workers for file reading, feature extraction and XGBoost (-1 = all cores)
BIOVID_N_JOBS=-1

# Optional: the feature table published with Gruss et al. (2015), PLoS ONE 10(10): e0140330.
# It ships with the BioVid download as PartB_PLOS_ONE_2015_biofeatures/Table_Step2_159Features-85Subs-5Levels-z.xlsx.
# When set, Step 9 evaluates that feature set under the same protocol; leave it empty to skip Step 9.
BIOVID_PLOS_FEATURES=
